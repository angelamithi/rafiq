{$DOMAIN} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}

	# Only the webhook and health endpoints are public.
	@public path /webhook/whatsapp /webhook/telegram /health
	handle @public {
		request_body {
			max_size 512KB
		}
		reverse_proxy web:8000
	}

	# Judges' demo (only answers when DEMO_ENABLED=true; needs the demo code). Bigger limit for photo/PDF uploads.
	@demo path /demo /demo/api/*
	handle @demo {
		request_body {
			max_size 5MB
		}
		reverse_proxy web:8000
	}

	handle {
		respond 404
	}
}
