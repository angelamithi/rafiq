# Copy to .env on the VPS:   cp .env.example .env && chmod 600 .env
# Generate secrets with:      docker compose run --rm --no-deps web python scripts/generate_secrets.py
# Never commit .env to git.

# ---------- General ----------
APP_ENV=production
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://rafiq.example.com
DOMAIN=rafiq.example.com

# ---------- Storage (docker-compose service names) ----------
POSTGRES_USER=rafiq
POSTGRES_DB=rafiq
POSTGRES_PASSWORD=change-me-long-random
DATABASE_URL=postgresql+asyncpg://rafiq:change-me-long-random@postgres:5432/rafiq
REDIS_PASSWORD=change-me-long-random
REDIS_URL=redis://:change-me-long-random@redis:6379/0
USE_QUEUE=true

# ---------- WhatsApp Cloud API (Meta developer dashboard) ----------
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
# Approved utility template for visa reminders (see README). Empty = no WhatsApp reminders.
WHATSAPP_VISA_TEMPLATE=
# Approved utility template for "you fly in N days" reminders (Departure Planner).
WHATSAPP_DEPARTURE_TEMPLATE=
# Approved utility template for "finish your residence visa" reminders (Arrival Guide).
WHATSAPP_ARRIVAL_TEMPLATE=
# Approved utility template for monthly salary check-ins (Pay & Rights).
WHATSAPP_PAY_TEMPLATE=
# Approved utility template for the opt-in weekly wellbeing check-in (Friends & wellbeing).
WHATSAPP_SOCIAL_TEMPLATE=

# AI intent understanding: when the rules don't recognise a message, Gemini picks a topic (from a fixed list only).
INTENT_AI_ENABLED=true
INTENT_AI_PER_DAY=50

# Voice notes: transcribed and translated into English by Gemini (needs GOOGLE_API_KEY and LLM_ENABLED).
VOICE_ENABLED=true
VOICE_MAX_SECONDS=180
VOICE_PER_DAY=30

# Rule Monitor (weekly checks of official sources). Alerts go to this Telegram chat id (your team's).
RULE_MONITOR_ENABLED=true
ADMIN_TELEGRAM_CHAT_ID=
WHATSAPP_TEMPLATE_LANGUAGE=en

# ---------- Telegram (for testing while Meta verification is pending) ----------
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ---------- AI model: Google Gemini ----------
# Get a key at Google AI Studio. If the AI is off or fails, Rafiq falls back
# to its built-in rules, so job checks always work (photos need the AI).
LLM_ENABLED=true
LLM_MAIN_MODEL=google_genai:gemini-3.7-flash
LLM_DOC_MODEL=
LLM_TIMEOUT_SECONDS=20
LLM_DOC_TIMEOUT_SECONDS=45
GOOGLE_API_KEY=

# ---------- Photos and PDFs ----------
MEDIA_MAX_BYTES=10000000
PDF_MAX_PAGES=5

# ---------- Security (REQUIRED in production) ----------
FIELD_ENCRYPTION_KEY=
ID_HASH_PEPPER=
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_DAY=300
MAX_MESSAGE_CHARS=4000
GUARD_STRIKES_BEFORE_COOLDOWN=3
GUARD_COOLDOWN_MINUTES=30

# ---------- Privacy ----------
# Change this date whenever the privacy notice changes: users are asked to agree again.
PRIVACY_POLICY_VERSION=2026-11-20.1
DATA_RETENTION_DAYS_INACTIVE=365
