# Add this block to the SHARED Caddyfile (the one used by the shared_caddy
# container), then reload:  docker exec shared_caddy caddy reload --config /etc/caddy/Caddyfile
# Same protections as Rafiq's own Caddyfile: only the webhooks, /health and the judges' demo are public.

rafiq.afrivance.ai {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}

	@public path /webhook/whatsapp /webhook/telegram /health
	handle @public {
		request_body {
			max_size 512KB
		}
		reverse_proxy rafiq-web:8000
	}

	# Judges' demo (only answers when DEMO_ENABLED=true; needs the demo code). Bigger limit for photo/PDF uploads.
	@demo path /demo /demo/api/*
	handle @demo {
		request_body {
			max_size 5MB
		}
		reverse_proxy rafiq-web:8000
	}

	handle {
		respond 404
	}
}
